[layer_names]

2d_physics/layer_1="ground"
2d_physics/layer_2="player"
2d_physics/layer_3="player_checkarea"
2d_physics/layer_4="point"
2d_physics/layer_5="check_area"
2d_physics/layer_6="bear"
2d_physics/layer_7="barrier"
2d_physics/layer_8="water"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.86, 0.95, 0.92, 1)
